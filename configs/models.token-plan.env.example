# Non-secret role settings. Merge these into .env; retain your own gateway credentials.
# One fixed assignment per role in both experimental arms. No automatic model fallback.
# Quality-oriented thinking profile. Actual gateway support is verified by the user-run experiment.
DESIGNER_MODEL=qwen3.8-max
DESIGNER_ENABLE_THINKING=true
DESIGNER_JSON_MODE=true
DESIGNER_STREAM=true
DESIGNER_TOKEN_PARAMETER=max_tokens
DESIGNER_TIMEOUT_SECONDS=1800
DESIGNER_MAX_OUTPUT_TOKENS=65536

ART_PLANNER_MODEL=qwen3.8-flash
ART_PLANNER_ENABLE_THINKING=true
ART_PLANNER_JSON_MODE=true
ART_PLANNER_STREAM=true
ART_PLANNER_TOKEN_PARAMETER=max_tokens
ART_PLANNER_TIMEOUT_SECONDS=1800
ART_PLANNER_MAX_OUTPUT_TOKENS=65536

CODE_DEVELOPER_MODEL=deepseek-v4-pro-0813
CODE_DEVELOPER_ENABLE_THINKING=true
CODE_DEVELOPER_JSON_MODE=true
CODE_DEVELOPER_STREAM=true
CODE_DEVELOPER_TOKEN_PARAMETER=max_tokens
CODE_DEVELOPER_TIMEOUT_SECONDS=1800
CODE_DEVELOPER_MAX_OUTPUT_TOKENS=131072
CODE_DEVELOPER_REASONING_EFFORT=high

PLAYER_MODEL=qwen3.8-flash
PLAYER_ENABLE_THINKING=true
PLAYER_JSON_MODE=true
PLAYER_STREAM=true
PLAYER_TOKEN_PARAMETER=max_tokens
PLAYER_TIMEOUT_SECONDS=1800
PLAYER_MAX_OUTPUT_TOKENS=32768
PLAYER_VISION=true

QA_MODEL=qwen3.8-max
QA_ENABLE_THINKING=true
QA_JSON_MODE=true
QA_STREAM=true
QA_TOKEN_PARAMETER=max_tokens
QA_TIMEOUT_SECONDS=1800
QA_MAX_OUTPUT_TOKENS=65536
QA_VISION=true

# Reserved settings only: no separate SVG service is implemented here.
ART_SVG_MODEL=qwen3.8-flash
ART_SVG_ENABLE_THINKING=false
ART_SVG_JSON_MODE=true
ART_SVG_STREAM=false
ART_SVG_TOKEN_PARAMETER=max_tokens
ART_SVG_TIMEOUT_SECONDS=240
ART_SVG_MAX_OUTPUT_TOKENS=8192

# Active only with examples/scheduler_demo.py; charged to the shared total budget.
SCHEDULER_MODEL=qwen3.7-plus
SCHEDULER_ENABLE_THINKING=false
SCHEDULER_JSON_MODE=true
SCHEDULER_STREAM=false
SCHEDULER_TOKEN_PARAMETER=max_tokens
SCHEDULER_TIMEOUT_SECONDS=240
SCHEDULER_MAX_OUTPUT_TOKENS=4096
# Local request-byte cap and single-decision input reservation ceiling (not a model context window).
SCHEDULER_MAX_PROMPT_BYTES=1048576
SCHEDULER_MAX_INPUT_TOKENS=2097152

# Fixed Loop uses this real image model by default; older single-role demos still use mock images.
# Native DashScope image SDK; Chat Completions settings above remain unchanged.
# On Alibaba hosts, derive /api/v1 from the shared /compatible-mode/v1 base.
# Credentials: ART_IMAGE_API_KEY > DASHSCOPE_API_KEY > MODEL_GATEWAY_API_KEY.
ART_IMAGE_PROVIDER=dashscope
ART_IMAGE_MODEL=wan2.7-image
ART_IMAGE_TIMEOUT_SECONDS=600
ART_IMAGE_SIZE=1024*1024
ART_IMAGE_TRANSPARENCY=chroma_key
ART_IMAGE_CHROMA_TOLERANCE=40
ART_IMAGE_RESAMPLE=nearest
ART_IMAGE_WATERMARK=false
# Optional: choose the native base URL in the same region as your key/model.
# ART_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# ART_IMAGE_API_KEY=your-image-key
# ART_IMAGE_SEED=42
# Qwen Image models that support this option only; leave unset for Wan 2.7.
# ART_IMAGE_PROMPT_EXTEND=false

# Expanded thinking run: local prompt byte caps and metered token ceilings.
DESIGNER_MAX_PROMPT_BYTES=1048576
ART_PLANNER_MAX_PROMPT_BYTES=1048576
CODE_DEVELOPER_MAX_PROMPT_BYTES=4194304
PLAYER_MAX_PROMPT_BYTES=1572864
QA_MAX_PROMPT_BYTES=2097152
DEVELOPER_VISUAL_MAX_OUTPUT_TOKENS=32768
FIXED_LOOP_ROLE_MAX_INPUT_TOKENS=40000000
FIXED_LOOP_MAX_INPUT_TOKENS=128000000
FIXED_LOOP_MAX_OUTPUT_TOKENS=8000000
